# Tailscale sidecar: replace this key with a non-ephemeral auth key if using Tailscale Compose.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Optional offline AI configuration. Start the 'ai' Docker Compose profile.
CLIPFORGE_AI_MODEL=llama3.2:3b
CLIPFORGE_WHISPER_MODEL=base
# CLIPFORGE_OLLAMA_URL=http://ollama:11434

# Publishing uses your own approved API credentials, supplied server-side only.
# Google OAuth2 refresh token must have youtube.upload scope.
# CLIPFORGE_YOUTUBE_CLIENT_ID=
# CLIPFORGE_YOUTUBE_CLIENT_SECRET=
# CLIPFORGE_YOUTUBE_REFRESH_TOKEN=
# Instagram requires a professional account and instagram_content_publish permission.
# CLIPFORGE_INSTAGRAM_TOKEN=
# CLIPFORGE_INSTAGRAM_USER_ID=
# CLIPFORGE_FACEBOOK_PAGE_ACCESS_TOKEN=
# TikTok uses video.upload scope to send a draft to the account inbox.
# CLIPFORGE_TIKTOK_ACCESS_TOKEN=
