# Optional NVIDIA/CUDA build for faster-whisper. Keep the normal Dockerfile
# unchanged so machines without GPU drivers and toolkit can run on the CPU.
FROM denoland/deno:bin-2.9.8 AS deno-bin

# CTranslate2 requires CUDA 12 and cuDNN 9 for current faster-whisper releases.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv ffmpeg ca-certificates fonts-dejavu-core \
    libgomp1 passwd && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/clipforge-venv
ENV PATH="/opt/clipforge-venv/bin:${PATH}"
COPY --from=deno-bin /deno /usr/local/bin/deno
RUN deno --version
WORKDIR /app
COPY pyproject.toml README.md ./
COPY clipforge ./clipforge
RUN pip install --no-cache-dir ".[ai]" && useradd -m -u 10001 clipforge \
    && mkdir -p /data && chown clipforge:clipforge /data
USER clipforge
ENV CLIPFORGE_DATA_DIR=/data CLIPFORGE_HOST=0.0.0.0 CLIPFORGE_PORT=8765
EXPOSE 8765
CMD ["clipforge"]
